---
import Docs from '../layouts/Docs.astro';
import Swatch from '../components/Swatch.astro';
import TableWrap from '../components/TableWrap.astro';
import { resolved, source, contrast, leaves, refName, cssVarForPath, componentVar, camel, SHADCN_MAP } from '../lib/flint.js';

// One real decision, traced from the ladder to every platform. All of it read from the build.
const compPath = ['button', 'primary', 'bg'];
const semRef = refName(source.component.button.primary.bg);            // semantic.action.primary
const semPath = semRef.split('.').slice(1);                             // ['action','primary']
const primLight = refName(source.semantic.light.action.primary);        // color.blue.700
const primDark = refName(source.semantic.dark.action.primary);          // color.blue.300
const val = (mode) => resolved.semantic[mode].action.primary;
const shadcnName = Object.entries(SHADCN_MAP).find(([, p]) => p === semRef)?.[0];

const semanticCount = leaves(resolved.semantic.light).length;
const componentCount = leaves(resolved.component.light).length;
const pairsPerMode = contrast.pairs.length / 2;
---
<Docs home description="Flint is the design system behind AccessSpark and Inner Spark Media: one token source for CSS, MUI, shadcn/ui and SwiftUI.">
  <section class="hero" aria-labelledby="page-title">
    <h1 id="page-title" tabindex="-1">Flint</h1>
    <p class="lead">
      The design system behind AccessSpark and Inner Spark Media. One token source drives CSS, MUI, shadcn/ui and SwiftUI,
      and every build proves they agree and that the text clears 7:1.
    </p>
    <div class="hero-actions">
      <a class="flint-btn flint-btn--primary" href="/get-started/">Get started</a>
      <a class="flint-btn flint-btn--secondary" href="/foundations/color/">Browse foundations</a>
    </div>

    <div class="flow">
      <h2 id="flow-title">One decision, every platform</h2>
      <p>The primary button's fill, traced from the color ladder to the code each platform ships. Change one ladder step and all of it follows.</p>
      <ol class="flow-track" aria-labelledby="flow-title">
        <li class="flow-step">
          <p class="flow-tier">Primitive</p>
          <span class="flow-name">{primLight.split('.').slice(0, 2).join('.')}</span>
          <div class="flow-values">
            <Swatch value={resolved.color.blue[primLight.split('.')[2]]} note={`step ${primLight.split('.')[2]}, light`} />
            <Swatch value={resolved.color.blue[primDark.split('.')[2]]} note={`step ${primDark.split('.')[2]}, dark`} />
          </div>
        </li>
        <li class="flow-step">
          <p class="flow-tier">Semantic</p>
          <span class="flow-name">{semPath.join('.')}</span>
          <div class="flow-values">
            <Swatch value={val('light')} note="light" />
            <Swatch value={val('dark')} note="dark" />
          </div>
        </li>
        <li class="flow-step">
          <p class="flow-tier">Component</p>
          <span class="flow-name">{compPath.join('.')}</span>
          <div class="flow-values">
            <Swatch value={resolved.component.light.button.primary.bg} note="light" />
            <Swatch value={resolved.component.dark.button.primary.bg} note="dark" />
          </div>
        </li>
        <li class="flow-step">
          <p class="flow-tier">Platforms</p>
          <ul class="flow-out">
            <li><span>CSS</span><code>{componentVar(compPath)}</code></li>
            <li><span>MUI</span><code>palette.primary.main</code></li>
            <li><span>shadcn</span><code>{shadcnName}</code></li>
            <li><span>Swift</span><code>Flint.Component.{camel(...compPath)}</code></li>
          </ul>
        </li>
      </ol>
    </div>
  </section>

  <div class="home-body">
    <h2 id="platforms">Start with your platform</h2>
    <ul class="link-list">
      <li><a href="/get-started/web/"><strong>Web and CSS</strong><span>Variables for Astro, EJS and any static site. Dark mode and density are one attribute each.</span></a></li>
      <li><a href="/get-started/mui/"><strong>MUI</strong><span>A ready theme for React apps on MUI, in light and dark, comfortable and compact.</span></a></li>
      <li><a href="/get-started/shadcn/"><strong>shadcn/ui</strong><span>One import maps every shadcn variable onto Flint for Tailwind v4 projects.</span></a></li>
      <li><a href="/get-started/ios/"><strong>iOS and SwiftUI</strong><span>A Swift package with colors, type, space, motion and UIKit colors.</span></a></li>
      <li><a href="/get-started/figma/"><strong>Figma</strong><span>The Flint library mirrors the tokens. If they ever disagree, the repo wins.</span></a></li>
    </ul>

    <h2 id="checks">What every build checks</h2>
    <p>A release cannot ship if any of these fail.</p>
    <TableWrap label="Build checks">
      <table class="data">
        <thead><tr><th scope="col">Check</th><th scope="col">Covers</th><th scope="col">Bar</th></tr></thead>
        <tbody>
          <tr><th scope="row">Contrast</th><td>{pairsPerMode} pairings in each mode, from body text to chart marks</td><td>7:1 for text, 3:1 for edges, focus rings and marks</td></tr>
          <tr><th scope="row">Parity</th><td>{semanticCount} semantic and {componentCount} component tokens across CSS, MUI, shadcn and Swift</td><td>Every platform lands on the value tokens.json gives it</td></tr>
          <tr><th scope="row">Usage</th><td>Control edges and density</td><td>No control drawn with a decorative border; density never shrinks a target</td></tr>
          <tr><th scope="row">Pages</th><td>These docs and the workbench, light and dark</td><td>Zero axe violations, WCAG 2.2 A and AA</td></tr>
        </tbody>
      </table>
    </TableWrap>

    <h2 id="foundations">Foundations</h2>
    <ul class="link-list">
      <li><a href="/foundations/color/"><strong>Color</strong><span>{semanticCount} semantic colors per mode and the ladders they point at.</span></a></li>
      <li><a href="/foundations/typography/"><strong>Typography</strong><span>{Object.keys(resolved.typography).length} type styles in Open Sans, nothing below 12px.</span></a></li>
      <li><a href="/foundations/spacing/"><strong>Spacing and size</strong><span>The spacing scale, radius, control heights and the 24px minimum target.</span></a></li>
      <li><a href="/foundations/contrast/"><strong>Contrast</strong><span>Every pairing the build measures, with its ratio.</span></a></li>
    </ul>
  </div>
</Docs>
