---
import Docs from '../layouts/Docs.astro';
import Swatch from '../components/Swatch.astro';
import TableWrap from '../components/TableWrap.astro';
import Illustration from '../components/Illustration.astro';
import { PRINCIPLE_GROUPS } from '../data/principles.js';
import { COMPONENTS } from '../data/components.js';
import { resolved, source, contrast, leaves, refName, componentVar, camel, SHADCN_MAP } from '../lib/flint.js';
import '../styles/home.css';

// One real decision, traced from the ladder to every platform. All of it read from the build.
const compPath = ['button', 'primary', 'bg'];
const semRef = refName(source.component.button.primary.bg);            // semantic.action.primary
const semPath = semRef.split('.').slice(1);                             // ['action','primary']
const primLight = refName(source.semantic.light.action.primary);        // color.blue.700
const primDark = refName(source.semantic.dark.action.primary);          // color.blue.300
const val = (mode) => resolved.semantic[mode].action.primary;
const shadcnName = Object.entries(SHADCN_MAP).find(([, p]) => p === semRef)?.[0];

const semanticCount = leaves(resolved.semantic.light).length;
const componentCount = leaves(resolved.component.light).length;
const pairsPerMode = contrast.pairs.length / 2;
const shippedComponents = Object.values(COMPONENTS).map((c) => c.name);

const platforms = [
  ['Web', '/get-started/web/', 'CSS variables and component classes for any stack, plus Flint React, a ready MUI theme and a shadcn/ui bridge.'],
  ['iOS and SwiftUI', '/get-started/ios/', 'A Swift package with colors, type, space, motion and UIKit colors.'],
  ['Figma', '/get-started/figma/', 'The Flint library mirrors the tokens. If they ever disagree, the repo wins.'],
  ['Components', '/components/', `${shippedComponents.join(', ')}. One page each, for web and iOS.`],
];
const foundations = [
  ['Color', '/foundations/color/', `${semanticCount} semantic colors per mode, every contrast pairing the build measures, and the chart palette.`],
  ['Typography', '/foundations/typography/', `${Object.keys(resolved.typography).length} type styles in Open Sans, nothing below 12px.`],
  ['Spacing and size', '/foundations/spacing/', 'The spacing scale, radius, control heights and the 24px minimum target.'],
  ['Motion', '/foundations/motion/', 'Durations and easing as tokens, and what changes under reduced motion.'],
  ['Token explorer', '/foundations/tokens/', 'Follow any token to the ladder, in light and dark, with its name on every platform.'],
];
---
<Docs home description="Flint is the design system behind AccessSpark and Inner Spark Media: one token source for CSS, MUI, shadcn/ui and SwiftUI.">
  <section class="hero" aria-labelledby="page-title">
    <div class="home-wrap hero-grid">
      <div>
        <p class="eyebrow">Flint design system</p>
        <h1 id="page-title" tabindex="-1">Accessible by default, on every platform.</h1>
        <p class="lead">
          The design system behind AccessSpark and Inner Spark Media. One token source drives CSS, MUI, shadcn/ui and SwiftUI,
          and every build proves they agree and that the text clears 7:1.
        </p>
        <div class="hero-actions">
          <a class="flint-btn flint-btn--primary" href="/get-started/">Get started</a>
          <a class="flint-btn flint-btn--secondary" href="/principles/">Read the principles</a>
        </div>
      </div>
      <div class="hero-art"><Illustration name="tiers" /></div>
    </div>
  </section>

  <section class="band band-subtle" aria-labelledby="platforms">
    <div class="home-wrap">
      <p class="eyebrow">Get started</p>
      <h2 id="platforms">Start with your platform</h2>
      <ul class="cards">
        {platforms.map(([t, href, d]) => (
          <li class="card"><h3><a href={href}>{t}</a></h3><p>{d}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band" aria-labelledby="flow-title">
    <div class="home-wrap">
      <p class="eyebrow">How it works</p>
      <h2 id="flow-title">One decision, every platform</h2>
      <p class="band-lead">The primary button's fill, traced from the color ladder to the code each platform ships. Change one ladder step and all of it follows.</p>
      <ol class="flow-track" aria-labelledby="flow-title">
        <li class="flow-step">
          <p class="flow-tier">Primitive</p>
          <span class="flow-name">{primLight.split('.').slice(0, 2).join('.')}</span>
          <div class="flow-values">
            <Swatch value={resolved.color.blue[primLight.split('.')[2]]} note={`step ${primLight.split('.')[2]}, light`} />
            <Swatch value={resolved.color.blue[primDark.split('.')[2]]} note={`step ${primDark.split('.')[2]}, dark`} />
          </div>
        </li>
        <li class="flow-step">
          <p class="flow-tier">Semantic</p>
          <span class="flow-name">{semPath.join('.')}</span>
          <div class="flow-values">
            <Swatch value={val('light')} note="light" />
            <Swatch value={val('dark')} note="dark" />
          </div>
        </li>
        <li class="flow-step">
          <p class="flow-tier">Component</p>
          <span class="flow-name">{compPath.join('.')}</span>
          <div class="flow-values">
            <Swatch value={resolved.component.light.button.primary.bg} note="light" />
            <Swatch value={resolved.component.dark.button.primary.bg} note="dark" />
          </div>
        </li>
        <li class="flow-step">
          <p class="flow-tier">Platforms</p>
          <ul class="flow-out">
            <li><span>CSS</span><code>{componentVar(compPath)}</code></li>
            <li><span>MUI</span><code>palette.primary.main</code></li>
            <li><span>shadcn</span><code>{shadcnName}</code></li>
            <li><span>Swift</span><code>Flint.Component.{camel(...compPath)}</code></li>
          </ul>
        </li>
      </ol>
      <p class="more"><a class="flint-link flint-link--standalone" href="/foundations/tokens/">Trace any token in the explorer <span aria-hidden="true">&rarr;</span></a></p>
    </div>
  </section>

  <section class="band band-subtle" aria-labelledby="principles">
    <div class="home-wrap">
      <p class="eyebrow">Principles</p>
      <h2 id="principles">How Flint looks, behaves and talks</h2>
      <ul class="cards cards-3">
        {PRINCIPLE_GROUPS.map((g) => (
          <li class="card card-art">
            <Illustration name={g.illustration} />
            <h3><a href={`/principles/#${g.id}`}>{g.title}</a></h3>
            <p>{g.lead}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band" aria-labelledby="checks">
    <div class="home-wrap">
      <p class="eyebrow">Proof</p>
      <h2 id="checks">What every build checks</h2>
      <p class="band-lead">A release cannot ship if any of these fail.</p>
      <TableWrap label="Build checks">
        <table class="data">
          <thead><tr><th scope="col">Check</th><th scope="col">Covers</th><th scope="col">Bar</th></tr></thead>
          <tbody>
            <tr><th scope="row">Contrast</th><td>{pairsPerMode} pairings in each mode, from body text to chart marks</td><td>7:1 for text, 3:1 for edges, focus rings and marks</td></tr>
            <tr><th scope="row">Parity</th><td>{semanticCount} semantic and {componentCount} component tokens across CSS, MUI, shadcn and Swift</td><td>Every platform lands on the value tokens.json gives it</td></tr>
            <tr><th scope="row">Components</th><td>Every rule in components.css</td><td>No color literals, no unknown variables, no stray px values</td></tr>
            <tr><th scope="row">Usage</th><td>Control edges and density</td><td>No control drawn with a decorative border; density never shrinks a target</td></tr>
            <tr><th scope="row">Pages</th><td>Every docs page, light and dark</td><td>Zero axe violations, WCAG 2.2 A and AA</td></tr>
          </tbody>
        </table>
      </TableWrap>
    </div>
  </section>

  <section class="band band-subtle" aria-labelledby="foundations">
    <div class="home-wrap">
      <p class="eyebrow">Foundations</p>
      <h2 id="foundations">The decisions under every component</h2>
      <ul class="cards">
        {foundations.map(([t, href, d]) => (
          <li class="card"><h3><a href={href}>{t}</a></h3><p>{d}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="cta-band" aria-labelledby="cta">
    <div class="home-wrap">
      <h2 id="cta">Build it once. Ship it everywhere.</h2>
      <p>Install Flint by git tag and pick up every fix on the next update.</p>
      <a class="flint-btn flint-btn--secondary" href="/get-started/">Get started</a>
    </div>
  </section>
</Docs>
