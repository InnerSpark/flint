---
import Docs from '../../../layouts/Docs.astro';
import ColorRow from '../../../components/ColorRow.astro';
import { resolved } from '../../../lib/flint.js';
import { specFor, varOf } from '../../../data/colorRoles.js';
const keys = Object.keys(resolved.semantic.light.chart);
// Simulations use the Machado, Oliveira and Fernandes (2009) matrices at full severity, and luminance
// for grayscale. A preview of how series separate, not a diagnosis tool.
const VISION = [
  ['typical', 'Typical color vision', null],
  ['protan', 'Protanopia (no red cones)', '0.152 1.053 -0.205 0 0  0.115 0.786 0.099 0 0  -0.004 -0.048 1.052 0 0  0 0 0 1 0'],
  ['deutan', 'Deuteranopia (no green cones)', '0.367 0.861 -0.228 0 0  0.280 0.673 0.047 0 0  -0.012 0.043 0.969 0 0  0 0 0 1 0'],
  ['tritan', 'Tritanopia (no blue cones)', '1.256 -0.077 -0.179 0 0  -0.078 0.931 0.148 0 0  0.005 0.691 0.304 0 0  0 0 0 1 0'],
  ['gray', 'Grayscale', '0.2126 0.7152 0.0722 0 0  0.2126 0.7152 0.0722 0 0  0.2126 0.7152 0.0722 0 0  0 0 0 1 0'],
];
const HEIGHTS = [70, 90, 55, 80, 40];
const toc = [{ id: 'categorical', text: 'Categorical colors' }, { id: 'vision', text: 'Under color vision deficiency' }, { id: 'rules', text: 'Rules' }];
---
<Docs title="Data visualization" crumb="Foundations" lead="Five categorical colors for charts, each clearing 3:1 against the surfaces charts sit on, in both modes." toc={toc} wide>
  <svg class="cvd-defs" aria-hidden="true" focusable="false" width="0" height="0">
    {VISION.filter(([, , m]) => m).map(([id, , m]) => (
      <filter id={`cvd-${id}`} color-interpolation-filters="linearRGB"><feColorMatrix type="matrix" values={m} /></filter>
    ))}
  </svg>

  <h2 id="categorical">Categorical colors</h2>
  <p>Use them in order. They map to shadcn's <code>--chart-1</code> through <code>--chart-5</code>. Each is measured against the surface charts sit on.</p>
  <ul class="cr-list">{keys.map((k) => <ColorRow spec={specFor(['chart', k])} />)}</ul>

  <h2 id="vision">Under color vision deficiency</h2>
  <p>The five series in order, simulated for the common types of color blindness. Where two bars look alike, label the series directly or add a pattern: never rely on color alone. The numbers under the bars are the direct labels doing that job.</p>
  <ul class="cr-list">
    {VISION.map(([id, label]) => (
      <li class="cr">
        <div class="cr-name"><h3>{label}</h3></div>
        {['light', 'dark'].map((mode) => (
          <div class="cr-mode">
            <p class="cr-mode-label">{mode === 'light' ? 'Light' : 'Dark'}</p>
            <div class="stage stage--sm" data-theme={mode} aria-hidden="true">
              <div class="stage-in stage-in--series" style={id === 'typical' ? '' : `filter:url(#cvd-${id})`}>
                {keys.map((k, i) => (
                  <span class="series-col"><span class="stage-bar" style={`height:${HEIGHTS[i]}%;background:var(${varOf(`chart.${k}`)})`}></span><span class="series-num">{k}</span></span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </li>
    ))}
  </ul>

  <h2 id="rules">Rules</h2>
  <ul>
    <li>Never let color carry meaning alone. Label series directly, or pair color with a pattern or marker shape.</li>
    <li>Keep to five series or fewer. More than that, group the rest or use small multiples.</li>
    <li>Give every chart a text summary of what it shows, for screen readers and for a quick read.</li>
    <li>Chart colors 1 and 5 are blue and red, and 4 is green: never rely on red against green to tell two series apart.</li>
  </ul>
</Docs>
