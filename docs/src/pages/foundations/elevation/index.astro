---
import Docs from '../../../layouts/Docs.astro';
import TableWrap from '../../../components/TableWrap.astro';
import { resolved } from '../../../lib/flint.js';
import '../../../styles/specimens.css';
const toc = [{ id: 'shadows', text: 'Shadows' }, { id: 'layers', text: 'Layers' }];
const use = { card: 'Cards and panels', popover: 'Menus and popovers', dialog: 'Dialogs and drawers', raised: 'Raised, floating elements' };
const layers = Object.entries(resolved.zIndex).reverse();
const layerUse = { base: 'The page', dropdown: 'Dropdown menus', sticky: 'Sticky headers', overlay: 'Scrims', modal: 'Dialogs', popover: 'Popovers over dialogs', toast: 'Toasts, always on top' };
---
<Docs title="Elevation" crumb="Foundations" lead="Four shadow levels, each with a dark-mode version, and a fixed stacking order." toc={toc} wide>
  <h2 id="shadows">Shadows</h2>
  <p>Each level on the page background, in light and dark. Dark shadows are deeper and add a faint edge, because a shadow alone barely shows on a dark page. The same variable name switches under <code>data-theme="dark"</code>.</p>
  <div class="elev-pair">
    {['light', 'dark'].map((mode) => (
      <figure class="elev-panel" data-theme={mode}>
        <figcaption>{mode === 'light' ? 'Light' : 'Dark'}</figcaption>
        <ul class="elev-grid">
          {Object.keys(resolved.shadow).map((k) => <li class="elev-card" style={`box-shadow:var(--shadow-${k})`}><code>--shadow-{k}</code><span>{use[k]}</span></li>)}
        </ul>
      </figure>
    ))}
  </div>

  <h2 id="layers">Layers</h2>
  <p>A fixed stacking order, so a toast always lands above a dialog and a dialog above a sticky header. Use the token, never a raw z-index.</p>
  <ol class="spec-sheet layer-stack">
    {layers.map(([k, v], i) => (
      <li class="layer" style={`--i:${layers.length - 1 - i}`}><span class="layer-plate" aria-hidden="true"></span><code>--z-{k}</code><span class="muted">{v} · {layerUse[k] || ''}</span></li>
    ))}
  </ol>
  <TableWrap label="Stacking order">
    <table class="data">
      <thead><tr><th scope="col">Token</th><th scope="col">z-index</th></tr></thead>
      <tbody>{Object.entries(resolved.zIndex).map(([k, v]) => <tr><th scope="row"><code>--z-{k}</code></th><td>{v}</td></tr>)}</tbody>
    </table>
  </TableWrap>
</Docs>
