---
import Docs from '../../../layouts/Docs.astro';
import ColorCard from '../../../components/ColorCard.astro';
import ColorRow from '../../../components/ColorRow.astro';
import PaintStrip from '../../../components/PaintStrip.astro';
import Guidance from '../../../components/Guidance.astro';
import { resolved, leaves, at, isColor } from '../../../lib/flint.js';
import { CORE, CORE_USE, specFor } from '../../../data/colorRoles.js';

const rows = leaves(resolved.semantic.light).filter(([p]) => isColor(at(resolved.semantic.light, p)));
const groups = [...new Set(rows.map(([p]) => p[0]))];
const about = {
  surface: 'Backgrounds: the page, cards, tinted areas, inverse bands and code.',
  text: 'Text and icons that sit on surfaces. Every pairing clears 7:1.',
  action: 'Interactive fills and their labels. Labels on a fill use its "on" token.',
  border: 'Edges. Only control, controlHover, focus and error may outline a control.',
  feedback: 'Success, warning, error and info. Keep each family together.',
  accent: 'Small highlights. Not for large fills.',
  selected: 'The selected state, always paired with a second cue such as weight or a bar.',
  chart: 'Data visualization marks. See Data visualization.',
  overlayScrim: 'The dimmed layer behind dialogs and drawers.',
};
const title = (g) => (g === 'overlayScrim' ? 'Overlay' : g[0].toUpperCase() + g.slice(1));
const ramps = Object.entries(resolved.color).filter(([, v]) => typeof v === 'object');
const toc = [{ id: 'core', text: 'Core roles' }, ...groups.map((g) => ({ id: g, text: title(g) })), { id: 'ladders', text: 'The ladders' }];
---
<Docs title="Color" crumb="Foundations" lead={`${rows.length} semantic colors in each mode, each one a reference to a step on the ladders below. Use semantic colors in UI. Never a ladder step, never a raw hex.`} toc={toc} wide>
  <Guidance doText="Use the semantic token for the role: text.muted for secondary text on any surface." dontText="Pick a gray from the ladder because it looks right. It won't follow dark mode or a future contrast fix." />
  <p id="hint-var" hidden>Copies the CSS variable.</p>
  <p id="hint-hex" hidden>Copies the hex value.</p>

  <section aria-labelledby="core">
    <h2 id="core">Core roles</h2>
    <p>The ten colors most screens are built from, each shown doing its job in light and in dark. Contrast is measured against the color it meets in use. Select a name to copy its CSS variable, or a hex to copy the value.</p>
    <ul class="cc-grid">{CORE.map((path) => <ColorCard spec={specFor(path.split('.'))} use={CORE_USE[path]} />)}</ul>
  </section>

  {groups.map((g) => (
    <section aria-labelledby={g}>
      <h2 id={g}>{title(g)}</h2>
      <p>{about[g]}</p>
      <ul class="cr-list">{rows.filter(([p]) => p[0] === g).map(([p]) => <ColorRow spec={specFor(p)} />)}</ul>
    </section>
  ))}

  <h2 id="ladders">The ladders</h2>
  <p>The primitive ramps every semantic color points at. Reference only: build UI from the semantic colors above. Each band says whether the step is safe for text on white. Select a band to copy its CSS variable.</p>
  <div class="ps-grid">{ramps.map(([ramp, steps]) => <PaintStrip ramp={ramp} steps={steps} />)}</div>
</Docs>
