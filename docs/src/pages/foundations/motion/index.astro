---
import Docs from '../../../layouts/Docs.astro';
import TableWrap from '../../../components/TableWrap.astro';
import Code from '../../../components/Code.astro';
import { resolved } from '../../../lib/flint.js';
import '../../../styles/specimens.css';
const easing = Object.entries(resolved.motion.easing);
const durations = Object.entries(resolved.motion.duration);
const easeUse = { standard: 'Moving between states', entrance: 'Things arriving', exit: 'Things leaving' };
// The curve of a cubic-bezier token, drawn in a 100 by 100 box (y up).
const curve = (v) => {
  const [x1, y1, x2, y2] = v.match(/[\d.]+/g).map(Number);
  return { d: `M0 100 C${x1 * 100} ${100 - y1 * 100} ${x2 * 100} ${100 - y2 * 100} 100 0`, h: [[0, 100, x1 * 100, 100 - y1 * 100], [100, 0, x2 * 100, 100 - y2 * 100]] };
};
const toc = [{ id: 'easing', text: 'Easing' }, { id: 'duration', text: 'Duration' }, { id: 'reduced', text: 'Reduced motion' }];
const cssCode = `.drawer {
  transition: transform var(--duration-base) var(--ease-entrance);
}
@media (prefers-reduced-motion: reduce) {
  .drawer { transition: none; }
}`;
---
<Docs title="Motion" crumb="Foundations" lead="Short, purposeful motion that shows what changed. Every animation has a reduced-motion version." toc={toc} wide>
  <p class="motion-note" data-reduced-note hidden>Reduced motion is on for your device, so these demos jump to the end instead of moving. That is how every Flint animation behaves for you.</p>

  <h2 id="easing">Easing</h2>
  <p>Each curve plots progress over time. Play runs a dot across with that curve at <code>--duration-slow</code>, the longest Flint allows.</p>
  <div class="spec-sheet motion-demo" data-motion>
    <button type="button" class="flint-btn flint-btn--secondary flint-btn--sm" data-play>Play</button>
    <ul class="ease-grid">
      {easing.map(([k, v]) => {
        const c = curve(v);
        return (
          <li class="ease-item">
            <svg class="ease-curve" viewBox="-6 -6 112 112" aria-hidden="true" focusable="false">
              <rect x="0" y="0" width="100" height="100" class="ease-box" />
              {c.h.map(([a, b, x, y]) => <line x1={a} y1={b} x2={x} y2={y} class="ease-handle" />)}
              <path d={c.d} class="ease-path" />
            </svg>
            <div class="track" aria-hidden="true"><span class="dot" style={`transition-timing-function:var(--ease-${k});transition-duration:var(--duration-slow)`}></span></div>
            <p><code>--ease-{k}</code></p>
            <p class="muted">{easeUse[k]} · <code>{v}</code></p>
          </li>
        );
      })}
    </ul>
  </div>

  <h2 id="duration">Duration</h2>
  <p>The same move at each duration, on <code>--ease-standard</code>. Small things use fast; things that travel far use slow.</p>
  <div class="spec-sheet motion-demo" data-motion>
    <button type="button" class="flint-btn flint-btn--secondary flint-btn--sm" data-play>Play</button>
    <ul class="dur-list">
      {durations.map(([k, v]) => (
        <li class="dur-row">
          <span class="dur-label"><code>--duration-{k}</code> <span class="muted">{v}</span></span>
          <div class="track" aria-hidden="true"><span class="dot" style={`transition-timing-function:var(--ease-standard);transition-duration:var(--duration-${k})`}></span></div>
        </li>
      ))}
    </ul>
  </div>
  <TableWrap label="Durations and easing">
    <table class="data">
      <thead><tr><th scope="col">Token</th><th scope="col">Value</th></tr></thead>
      <tbody>
        {durations.map(([k, v]) => <tr><th scope="row"><code>--duration-{k}</code></th><td>{v}</td></tr>)}
        {easing.map(([k, v]) => <tr><th scope="row"><code>--ease-{k}</code></th><td><code>{v}</code></td></tr>)}
      </tbody>
    </table>
  </TableWrap>

  <h2 id="reduced">Reduced motion</h2>
  <p>Gate every non-essential animation on <code>prefers-reduced-motion</code>, and name in the design what each animation becomes when it is off. On iOS, <code>Flint.Motion.animation(_:duration:reduceMotion:)</code> returns no animation when Reduce Motion is on.</p>
  <Code label="CSS" code={cssCode} />
</Docs>
<script>
  // Play: send every dot in the demo to the far end, or back. Under reduced motion they jump (no transition).
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const note = document.querySelector('[data-reduced-note]');
  if (note && reduce.matches) note.hidden = false;
  document.querySelectorAll('[data-motion]').forEach((demo) => {
    const button = demo.querySelector('[data-play]');
    button?.addEventListener('click', () => {
      const on = demo.classList.toggle('is-playing');
      button.textContent = on ? 'Play back' : 'Play';
    });
  });
</script>
