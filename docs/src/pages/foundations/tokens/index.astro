---
// Token explorer (ASDS-50, directory view ASDS-93): browse every token as folders, follow any token
// down to the ladder, see its value in each brand and what uses it. View only: tokens.json is the source.
// Every chain, value and name is computed here from Flint's build. Nothing is typed by hand.
import Docs from '../../../layouts/Docs.astro';
import TableWrap from '../../../components/TableWrap.astro';
import TokenTree from '../../../components/TokenTree.astro';
import brandAccessspark from '../../../../../dist/brands/accessspark/tokens.json';
import brandIsm from '../../../../../dist/brands/innersparkmedia/tokens.json';
import brandStudio from '../../../../../dist/brands/studio/tokens.json';
import Swatch from '../../../components/Swatch.astro';
import { COMPONENTS } from '../../../data/components.js';
import { source, resolved, leaves, at, refName, isColor, cssVarForPath, componentVar, camel, kebab, MODES } from '../../../lib/flint.js';
import swiftSrc from '../../../../../dist/swift/Flint.swift?raw';
import '../../../styles/explorer.css';

const lookup = (name, mode) => {
  const [h, ...r] = name.split('.');
  if (h === 'semantic') return at(source.semantic[mode], r);
  if (h === 'component') return at(source.component, r);
  return at(source, [h, ...r]);
};
const kindOf = (key) => (key.startsWith('component.') ? 'component' : key.startsWith('semantic.') ? 'semantic' : 'primitive');
const jsPath = (parts) => parts.map((k, i) => (i === 0 ? k : /^\d/.test(k) ? `[${k}]` : `.${k}`)).join('');
const swiftHas = (n) => new RegExp(`\\b${n}\\b`).test(swiftSrc);
const tryCss = (key) => { try { return cssVarForPath(key); } catch { return null; } };

const T = {};
const add = (key) => (T[key] ??= { key, kind: kindOf(key), chain: {}, value: {}, usedBy: {} });

for (const [p] of leaves(source.component)) add(`component.${p.join('.')}`).path = p;
for (const [p] of leaves(source.semantic.light)) add(`semantic.${p.join('.')}`).path = p;

// Walk each component and semantic token to its literal value, once per mode.
for (const t of Object.values(T)) {
  for (const mode of MODES) {
    let v = t.kind === 'component' ? at(source.component, t.path) : at(source.semantic[mode], t.path);
    const steps = [t.key];
    let r;
    while ((r = refName(v))) {
      const prev = steps[steps.length - 1];
      const target = add(r);
      (target.usedBy[prev] ??= new Set()).add(mode);
      steps.push(r);
      v = lookup(r, mode);
    }
    t.chain[mode] = steps;
    t.value[mode] = t.kind === 'component' ? at(resolved.component[mode], t.path) : at(resolved.semantic[mode], t.path);
  }
}
// Every primitive leaf gets an entry, referenced or not, so the directory shows the whole source.
for (const top of Object.keys(source).filter((k) => k !== 'semantic' && k !== 'component' && !k.startsWith('$'))) {
  for (const [p] of leaves(source[top])) if (!p.some((k) => k.startsWith('$'))) add([top, ...p].join('.'));
}
// Primitives: one value in both modes.
for (const t of Object.values(T).filter((x) => x.kind === 'primitive')) {
  const v = at(resolved, t.key.split('.')) ?? lookup(t.key, 'light');
  for (const mode of MODES) { t.value[mode] = v; t.chain[mode] = [t.key]; }
}

// Per-brand values, kept only where a brand differs from Flint.
const BRAND_TOKENS = { AccessSpark: brandAccessspark, 'Inner Spark Media': brandIsm, Studio: brandStudio };
const valueIn = (tok, t, mode) => (t.kind === 'component' ? at(tok.component[mode], t.path) : t.kind === 'semantic' ? at(tok.semantic[mode], t.path) : at(tok, t.key.split('.')));
const brandsFor = (t) => {
  const rows = Object.entries(BRAND_TOKENS).map(([name, tok]) => [name, MODES.map((m) => valueIn(tok, t, m))]);
  return rows.some(([, v]) => v.some((x, i) => String(x) !== String(t.value[MODES[i]]))) ? [['Flint', MODES.map((m) => t.value[m])], ...rows] : [];
};

const names = (t) => {
  const parts = t.key.split('.');
  if (t.kind === 'component') {
    const sw = camel(...t.path);
    return [['Figma', t.path.map(kebab).join('/')], ['CSS', componentVar(t.path)], ['JS', `component.light${jsPath(['', ...t.path]).slice(0)}`], ['Swift', swiftHas(sw) ? `Flint.Component.${sw}` : null]];
  }
  if (t.kind === 'semantic') {
    const sw = camel(...t.path);
    return [['Figma', t.path.map(kebab).join('/')], ['CSS', tryCss(t.key)], ['JS', `semantic.light${jsPath(['', ...t.path])}`], ['Swift', swiftHas(sw) ? `Flint.Colors.${sw}` : null]];
  }
  return [['CSS', tryCss(t.key)], ['JS', jsPath(parts)]];
};

const data = Object.values(T)
  .map((t) => ({
    key: t.key, kind: t.kind,
    chain: t.chain, value: t.value,
    color: MODES.some((m) => isColor(t.value[m])),
    names: names(t).filter(([, n]) => n),
    brands: brandsFor(t),
    usedBy: Object.entries(t.usedBy).map(([k, modes]) => [k, [...modes]]).sort(([a], [b]) => a.localeCompare(b)),
  }))
  .sort((a, b) => a.key.localeCompare(b.key));
const short = (key) => key.replace(/^(component|semantic)\./, '');
const initial = 'component.button.primary.bg';

// Directory: three sets, then folders by path, then tokens. Counts are tokens under each folder.
const SETS = [['component', 'Component'], ['semantic', 'Semantic'], ['primitive', 'Primitive']];
const build = (items, strip) => {
  const root = { children: new Map() };
  for (const d of items) {
    const parts = strip(d.key);
    let node = root, path = d.kind === 'primitive' ? [] : [d.kind];
    parts.forEach((part, i) => {
      path = [...path, part];
      if (i === parts.length - 1) { node.children.set(part + '\u0000', { name: part, path: path.join('.'), token: d.key, color: d.color ? d.value.light : undefined, count: 1, children: [] }); return; }
      if (!node.children.has(part)) node.children.set(part, { name: part, path: path.join('.'), count: 0, children: new Map() });
      node = node.children.get(part);
    });
  }
  const finish = (n) => { const kids = [...n.children.values()].map((c) => (c.token ? c : finish(c))); return { ...n, children: kids, count: kids.reduce((s, c) => s + c.count, 0) }; };
  return finish(root).children;
};
const tree = SETS.map(([kind, label]) => {
  const items = data.filter((d) => d.kind === kind);
  const children = build(items, (k) => (kind === 'primitive' ? k.split('.') : k.split('.').slice(1)));
  return { name: label, path: kind, count: items.length, children };
});
const total = data.length;
// Components with tokens but no docs page yet. Their tokens are listed here until the page ships;
// a component page then lists its own (and this list drops it), so every token has a home.
const documentedGroups = Object.entries(COMPONENTS).map(([slug, c]) => c.tokens || slug);
const pending = Object.keys(source.component).filter((k) => k !== 'focus' && !documentedGroups.includes(k));
const rowsFor = (name) => leaves(source.component[name]).map(([p, v]) => [[name, ...p], v]);
const show = (v) => (isColor(v) ? null : typeof v === 'number' ? `${v}px` : String(v));
---
<Docs
  title="Token explorer"
  crumb="Foundations"
  lead={`Browse all ${total} tokens as folders, the way they sit in tokens.json. Open a folder to see its tokens side by side, or pick one to see what it points at, its value in light, dark and each brand, its name on every platform, and what uses it.`}
  wide
>
  <div class="tx">
    <nav class="tx-nav" aria-labelledby="tx-nav-title">
      <h2 id="tx-nav-title" class="tx-nav-title">Tokens</h2>
      <div class="field tx-filter">
        <label for="tx-filter">Filter</label>
        <input id="tx-filter" class="flint-input" type="search" autocomplete="off" spellcheck="false" aria-describedby="tx-filter-help" />
        <p class="helper" id="tx-filter-help">Part of a name, like blue.700 or button.</p>
      </div>
      <p id="tx-count" class="visually-hidden" role="status" aria-live="polite"></p>
      <p id="tx-none" class="muted" hidden>No tokens match.</p>
      <ul class="tx-list tx-root" role="list">
        <TokenTree nodes={tree} />
      </ul>
    </nav>

    <div class="tx-view">
      <noscript><p>The explorer needs JavaScript. <a href="/guides/usage-rules/#tiers">Token tiers</a> explains the same chain without it.</p></noscript>
      <p id="explorer-status" class="visually-hidden" role="status" aria-live="polite"></p>
      <p class="tx-back"><a href="#tx-nav-title" id="tx-back">Back to the token list</a></p>

      <section class="explorer-result" aria-labelledby="result-title" hidden id="explorer-result">
        <h2 id="result-title" tabindex="-1"></h2>
        <p class="explorer-kind" id="result-kind"></p>

        <div id="group-view" hidden>
          <div class="table-wrap" role="region" aria-labelledby="result-title" tabindex="0">
            <table class="data">
              <thead><tr><th scope="col">Token</th><th scope="col" id="gv-light">Light</th><th scope="col" id="gv-dark">Dark</th><th scope="col">CSS</th></tr></thead>
              <tbody id="group-rows"></tbody>
            </table>
          </div>
        </div>

        <div id="token-view" hidden>
          <h3>Light and dark</h3>
          <div class="table-wrap" role="region" aria-label="Resolution in light and dark" tabindex="0">
            <table class="data">
              <thead><tr><th scope="col">Mode</th><th scope="col">Points at</th><th scope="col">Value</th></tr></thead>
              <tbody id="result-modes"></tbody>
            </table>
          </div>

          <div id="brand-view" hidden>
            <h3>By brand</h3>
            <div class="table-wrap" role="region" aria-label="Values by brand" tabindex="0">
              <table class="data">
                <thead><tr><th scope="col">Brand</th><th scope="col">Light</th><th scope="col">Dark</th></tr></thead>
                <tbody id="result-brands"></tbody>
              </table>
            </div>
          </div>

          <h3>Every name</h3>
          <div class="table-wrap" role="region" aria-label="Names by platform" tabindex="0">
            <table class="data">
              <thead><tr><th scope="col">Platform</th><th scope="col">Name</th></tr></thead>
              <tbody id="result-names"></tbody>
            </table>
          </div>

          <h3>Used by</h3>
          <p id="result-usedby-empty" class="muted">Nothing references this token directly. It is used in code.</p>
          <ul class="used-by" id="result-usedby"></ul>
        </div>
      </section>
    </div>
  </div>

  {pending.length > 0 && (
    <section aria-labelledby="pending">
      <h2 id="pending">Tokens for components without a page yet</h2>
      <p>These components have tokens but no docs page. Each table moves to its component's page when that page ships.</p>
      {pending.map((name) => (
        <>
          <h3 id={`pending-${name}`}>{name}</h3>
          <TableWrap label={`${name} component tokens`}>
            <table class="data">
              <thead><tr><th scope="col">Token</th><th scope="col">CSS</th><th scope="col">Points at</th><th scope="col">Light</th><th scope="col">Dark</th></tr></thead>
              <tbody>
                {rowsFor(name).map(([p, v]) => {
                  const l = at(resolved.component.light, p), d = at(resolved.component.dark, p);
                  return (
                    <tr data-token={`component.${p.join('.')}`}>
                      <th scope="row"><a href={`?token=component.${p.join('.')}`}><code>{p.join('.')}</code></a></th>
                      <td><code>{componentVar(p)}</code></td>
                      <td><code>{refName(v) || `${v}`}</code></td>
                      <td>{isColor(l) ? <Swatch value={l} /> : <code>{show(l)}</code>}</td>
                      <td>{isColor(d) ? <Swatch value={d} /> : <code>{show(d)}</code>}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </TableWrap>
        </>
      ))}
    </section>
  )}

  <script type="application/json" id="token-data" set:html={JSON.stringify(data)} />
  <script is:inline src="/token-explorer.js"></script>
</Docs>
