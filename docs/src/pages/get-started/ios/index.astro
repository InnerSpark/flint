import Docs from '../../../layouts/Docs.astro';
import Code from '../../../components/Code.astro';
import TableWrap from '../../../components/TableWrap.astro';
import PhoneDemo from '../../../components/PhoneDemo.astro';
import { glass } from '../../../lib/flint.js';
const toc = [{ id: 'try', text: 'Try it' }, { id: 'add', text: 'Add the package' }, { id: 'use', text: 'Use it' }, { id: 'reference', text: 'What is in the package' }, { id: 'components', text: 'Components' }, { id: 'chrome', text: 'Tab bar, nav bar and toolbar' }, { id: 'liquid-glass', text: 'Liquid Glass and contrast' }, { id: 'uikit', text: 'UIKit colors' }];
const useCode = `import SwiftUI
import Flint

struct TripCard: View {
  var body: some View {
    Text("Awning lights")
      .flintText(Flint.Typography.headingH2)
      .foregroundStyle(Flint.Colors.textHeading)
      .padding(Flint.Space.s16)
      .frame(minHeight: Flint.Target.minimum)
      .background(Flint.Colors.surfaceDefault,
                  in: RoundedRectangle(cornerRadius: Flint.Radius.card))
  }
}`;
const screenCode = `import SwiftUI
import UIKit
import Flint

struct TripsScreen: View {
  @State private var lightsOn = false
  @State private var tripName = ""
  @State private var started = false
  @Environment(\\.accessibilityReduceMotion) private var reduceMotion

  var body: some View {
    NavigationStack {
      ScrollView {
        VStack(alignment: .leading, spacing: Flint.Space.s16) {
          VStack(alignment: .leading, spacing: Flint.Space.s8) {
            Text("Awning lights")
              .flintText(Flint.Typography.headingH3)
              .foregroundStyle(Flint.Colors.textHeading)
              .accessibilityAddTraits(.isHeader)
            Text("Warm white strip along the awning.")
              .flintText(Flint.Typography.bodySm)
              .foregroundStyle(Flint.Colors.textMuted)
            Toggle("Lights", isOn: $lightsOn)
              .flintText(Flint.Typography.bodyMd)
              .tint(Flint.Colors.actionPrimary)
              .frame(minHeight: Flint.Target.minimum)
          }
          .padding(Flint.Space.s16)
          .background(Flint.Colors.surfaceDefault,
                      in: RoundedRectangle(cornerRadius: Flint.Radius.card))
          .overlay(RoundedRectangle(cornerRadius: Flint.Radius.card)
                     .stroke(Flint.Colors.borderDefault))

          Label("Rain after 6 PM. Pack the awning.", systemImage: "info.circle")
            .flintText(Flint.Typography.bodySm)
            .foregroundStyle(Flint.Colors.feedbackInfoText)
            .padding(Flint.Space.s12)
            .frame(maxWidth: .infinity, alignment: .leading)
            .background(Flint.Colors.feedbackInfoSurface,
                        in: RoundedRectangle(cornerRadius: Flint.Radius.control))

          VStack(alignment: .leading, spacing: Flint.Space.s8) {
            Text("Trip name")
              .flintText(Flint.Typography.labelDefault)
              .accessibilityHidden(true) // the field below carries the name
            TextField("Trip name", text: $tripName, prompt: Text("Big Bend, March"))
              .flintText(Flint.Typography.bodyMd)
              .padding(.horizontal, Flint.Space.s12)
              .frame(minHeight: Flint.Target.minimum)
              .overlay(RoundedRectangle(cornerRadius: Flint.Radius.control)
                         .stroke(Flint.Colors.borderControl))
          }

          Button {
            withAnimation(Flint.Motion.animation(.emphasis, reduceMotion: reduceMotion)) {
              started = true
            }
            UIAccessibility.post(notification: .announcement, argument: "Trip started")
          } label: {
            Text("Start trip")
              .flintText(Flint.Typography.labelButton)
              .frame(maxWidth: .infinity, minHeight: Flint.Target.minimum)
          }
          .foregroundStyle(Flint.Component.buttonPrimaryFg)
          .background(Flint.Component.buttonPrimaryBg,
                      in: RoundedRectangle(cornerRadius: Flint.Component.buttonRadius))

          if started {
            Text("Trip started")
              .flintText(Flint.Typography.labelDefault)
              .foregroundStyle(Flint.Colors.feedbackSuccessText)
              .frame(maxWidth: .infinity)
              .transition(.scale.combined(with: .opacity))
          }
        }
        .padding(Flint.Space.s16)
      }
      .background(Flint.Colors.surfacePage)
      .navigationTitle("Trips")
    }
  }
}`;
const chromeCode = `import SwiftUI
import Flint

@main
struct TripsApp: App {
  // Styles Apple's own bars once. They stay native: VoiceOver, the large content
  // viewer and iPad sidebars keep working.
  init() { FlintChrome.apply() }

  var body: some Scene {
    WindowGroup {
      TabView {
        NavigationStack {
          FlintScreen("Trips") {
            FlintNotice("Rain after 6 PM. Pack the awning.", tone: .info)
            Button("Start trip") {}.buttonStyle(.flint(.primary, fullWidth: true))
          }
        }
        .tabItem { Label("Trips", systemImage: "map") }

        NavigationStack {
          List {
            Section {
              FlintRow("Wi-Fi", value: "Trailer-5G", systemImage: "wifi")
              FlintRowButton("Delete trip", role: .destructive) {}
            } header: { FlintListHeader("Trailer") }
          }
          .flintList()
          .navigationTitle("Settings")
        }
        .tabItem { Label("Settings", systemImage: "gear") }
      }
      .tint(Flint.Colors.actionPrimary)
    }
  }
}`;
const components = [
  ['FlintButtonStyle', '`.buttonStyle(.flint(.primary))`: primary, secondary, danger and text, from the button tokens, 44pt tall.'],
  ['.flintCard()', 'Default surface, card radius, hairline edge.'],
  ['FlintNotice', 'Info, success, warning or error message with its icon, an optional title and actions.'],
  ['FlintTag', 'Status pill with words and an optional icon. Can carry a separate spoken label.'],
  ['FlintSectionTitle', 'Section heading with the header trait.'],
  ['FlintToggleRow', 'Large on/off row in a card; a disabled row shows and reads its reason.'],
  ['FlintChoicePicker', 'Segmented control that turns into a list of rows at large text sizes.'],
  ['FlintStepper', 'Large minus and plus, one VoiceOver element you swipe to adjust, separate spoken value.'],
  ['FlintStatTile', 'One reading with an icon, big value and detail; visual and spoken values kept apart.'],
  ['FlintEmptyState', 'What happened, optional numbered steps, one action.'],
  ['FlintScreen', 'Scrolling page with the page background, standard insets and a large or inline title.'],
  ['.flintList(), FlintRow, FlintRowButton, FlintListHeader', 'Settings-style grouped list. Rows read as one element and stack at accessibility sizes.'],
  ['.flintSheet(), FlintSheetHeader', 'Sheet with detents, a grab handle, a heading and a Close button. Liquid Glass on iOS 26 and later.'],
  ['.flintGlassButton()', 'Floating control over content: Liquid Glass on iOS 26 and later, a Flint button before.'],
  ['FlintChrome.apply()', 'Native navigation bar, tab bar, toolbar and alert styling. Keeps Liquid Glass on iOS 26 and later. iOS only.'],
];
const uikitCode = `let bar = UINavigationBarAppearance()
bar.backgroundColor = Flint.UIColors.surfacePage
bar.titleTextAttributes = [.foregroundColor: Flint.UIColors.textHeading]`;
---
<Docs illo="phone" title="iOS and SwiftUI" crumb="Get started" lead="A Swift package for iOS 16 and macOS 13 or later, built from the same tokens as the web." toc={toc}>
  <h2 id="try">Try it</h2>
  <p>A small Flint app on a phone: a tab bar, a navigation bar whose large title shrinks as you scroll, a settings list and a sheet. Switch appearance, drag the text size up to the accessibility sizes, turn on Reduce Motion, and tab through to read what VoiceOver says.</p>
  <PhoneDemo />
  <Code label="SwiftUI for this screen" code={screenCode} />

  <h2 id="add">Add the package</h2>
  <ol>
    <li>In Xcode, open File, then Add Package Dependencies.</li>
    <li>Enter <code>https://github.com/InnerSpark/flint</code> and pin it to a version.</li>
    <li>Add one product, the one for your brand: <code>Flint</code>, <code>FlintAccessSpark</code>, <code>FlintInnerSparkMedia</code> or <code>FlintStudio</code>. Each has the same API. See <a href="/foundations/brands/">Brands and platforms</a>.</li>
    <li>Bundle the Open Sans static fonts (Regular, Medium, SemiBold, Bold, ExtraBold) and list them under <code>UIAppFonts</code>.</li>
  </ol>

  <h2 id="use">Use it</h2>
  <Code label="SwiftUI" code={useCode} />

  <h2 id="reference">What is in the package</h2>
  <TableWrap label="Swift package contents">
    <table class="data">
      <thead><tr><th scope="col">Name</th><th scope="col">What it holds</th></tr></thead>
      <tbody>
        <tr><th scope="row"><code>Flint.Colors</code></th><td>Semantic colors. Each follows the system light and dark appearance.</td></tr>
        <tr><th scope="row"><code>Flint.UIColors</code></th><td>The same colors as dynamic <code>UIColor</code>, for UIKit APIs. <code>Flint.NSColors</code> on macOS.</td></tr>
        <tr><th scope="row"><code>Flint.Component</code></th><td>Button, input, checkbox and focus ring decisions.</td></tr>
        <tr><th scope="row"><code>Flint.Palette</code></th><td>The raw ladders. Reference only.</td></tr>
        <tr><th scope="row"><code>Flint.Typography</code></th><td>Type styles. Apply with <code>.flintText(_:)</code>; they scale with Dynamic Type.</td></tr>
        <tr><th scope="row"><code>Flint.Space</code>, <code>Flint.Radius</code></th><td>The spacing scale and radius, including <code>Radius.control</code> and <code>Radius.card</code>.</td></tr>
        <tr><th scope="row"><code>Flint.Control</code>, <code>Flint.IconSize</code></th><td>Control heights and icon sizes.</td></tr>
        <tr><th scope="row"><code>Flint.Target</code></th><td><code>minimum</code> is 44 (Apple HIG), from the iOS platform tokens. <code>touch</code> is the same value, kept for older code.</td></tr>
        <tr><th scope="row"><code>Flint.Motion</code></th><td>Durations and easing. <code>animation(_:duration:reduceMotion:)</code> returns nil when Reduce Motion is on.</td></tr>
      </tbody>
    </table>
  </TableWrap>

  <h2 id="components">Components</h2>
  <p>Every brand product ships the same components, drawn from that brand's tokens. See each one in light, dark and large text under <a href="/components/ios/">iOS components</a>. They keep Apple's accessibility behavior: Dynamic Type layouts, spoken values, Reduce Motion, and disabled reasons that are read aloud. Each has an Xcode preview in light, dark and Accessibility 3 text.</p>
  <TableWrap label="SwiftUI components">
    <table class="data">
      <thead><tr><th scope="col">Component</th><th scope="col">What it does</th></tr></thead>
      <tbody>{components.map(([n, d]) => <tr><th scope="row"><code>{n}</code></th><td>{d.split('`').map((part, i) => (i % 2 ? <code>{part}</code> : part))}</td></tr>)}</tbody>
    </table>
  </TableWrap>

  <h2 id="chrome">Tab bar, nav bar and toolbar</h2>
  <p>Flint styles Apple's own bars instead of replacing them. Call <code>FlintChrome.apply()</code> once at launch: titles use the <code>navTitleLarge</code> and <code>navTitle</code> styles, tab labels use <code>tabLabel</code>, and the selected tab shows its label and icon in the primary color. Alerts and confirmation dialogs stay native and pick up the tint.</p>
  <p><strong>Liquid Glass (iOS 26 and later).</strong> Apple asks apps to remove bar and sheet background customization, because it replaces the glass with a flat surface. So on iOS 26 and later <code>FlintChrome.apply()</code> sets only the title fonts and the selected-tab tint, and <code>.flintSheet()</code> leaves the background to the system. The bars then follow Reduce Transparency, Increase Contrast and the Clear and Tinted setting (iOS 26.1 and later) with no app code. iOS 16 to 25 get solid Flint bars from the same call. Glass is for the navigation layer: cards, notices and lists stay solid.</p>
  <Code label="SwiftUI app" code={chromeCode} />

  <h2 id="liquid-glass">Liquid Glass and contrast</h2>
  <p><strong>Liquid Glass can't guarantee contrast.</strong> What sits under the glass changes as people scroll, so no one can promise a ratio for text on it, Apple included. Flint ships native glass anyway, because a look-alike or a painted-over bar loses the system settings that fix it: Reduce Transparency makes the bars solid and Increase Contrast adds a strong edge. Flint's position:</p>
  <ul>
    <li><strong>Navigation layer only.</strong> Bars, sheets at medium height and floating buttons. Never cards, lists, notices or body text.</li>
    <li><strong>Selection never rests on color.</strong> On glass the selected tab's color can fall well under 4.5:1, so tabs always show a label and an icon, and the selected one gets a tinted pill.</li>
    <li><strong>Test with the settings on.</strong> Check every glass screen with Reduce Transparency and with Increase Contrast before release.</li>
    <li><strong>Tell people where the setting is.</strong> In your app's help, point to Settings, Display and Brightness, Liquid Glass, where Tinted makes the glass more opaque.</li>
  </ul>
  <p>The numbers below come from the build. They model the docs' glass: <code>surface/default</code> at 68% (light) or 70% (dark) over any flat color, the worst case for blur. Real glass also adapts its tint to the content, so treat them as a model, not a device measurement. Flint's bar is 7:1 for text and 4.5:1 is the WCAG AA minimum.</p>
  {Object.entries(glass.modes).map(([mode, rows]) => (
    <TableWrap label={`Glass contrast, ${mode}`}>
      <table class="data">
        <caption>{mode === 'light' ? 'Light' : 'Dark'} mode</caption>
        <thead><tr><th scope="col">Label</th><th scope="col">Worst case on glass</th><th scope="col">Solid, Reduce Transparency</th></tr></thead>
        <tbody>{rows.map((r) => <tr><th scope="row">{r.label}</th><td>{r.worst.toFixed(2)}:1{r.worst < glass.labelBar ? ' (under AA)' : r.worst < glass.textBar ? ' (under 7:1)' : ''}</td><td>{r.reduceTransparency.toFixed(2)}:1</td></tr>)}</tbody>
      </table>
    </TableWrap>
  ))}
  <p>See the principle <a href="/principles/#legible-any-background">Legible over any background</a>.</p>

  <h2 id="uikit">UIKit colors</h2>
  <p><code>UIColor(Flint.Colors.x)</code> locks to light mode. For UIKit APIs such as navigation bar appearance, use <code>Flint.UIColors</code>, which switch with the appearance.</p>
  <Code label="Swift" code={uikitCode} />

</Docs>
