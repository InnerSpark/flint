---
import Docs from '../../../layouts/Docs.astro';
import Code from '../../../components/Code.astro';
import TableWrap from '../../../components/TableWrap.astro';
import Notice from '../../../components/Notice.astro';
import PhoneDemo from '../../../components/PhoneDemo.astro';
const toc = [{ id: 'try', text: 'Try it' }, { id: 'add', text: 'Add the package' }, { id: 'use', text: 'Use it' }, { id: 'reference', text: 'What is in the package' }, { id: 'uikit', text: 'UIKit colors' }];
const useCode = `import SwiftUI
import Flint

struct TripCard: View {
  var body: some View {
    Text("Awning lights")
      .flintText(Flint.Typography.headingH2)
      .foregroundStyle(Flint.Colors.textHeading)
      .padding(Flint.Space.s16)
      .frame(minHeight: Flint.Target.touch)
      .background(Flint.Colors.surfaceDefault,
                  in: RoundedRectangle(cornerRadius: Flint.Radius.card))
  }
}`;
const screenCode = `import SwiftUI
import UIKit
import Flint

struct TripsScreen: View {
  @State private var lightsOn = false
  @State private var tripName = ""
  @State private var started = false
  @Environment(\\.accessibilityReduceMotion) private var reduceMotion

  var body: some View {
    NavigationStack {
      ScrollView {
        VStack(alignment: .leading, spacing: Flint.Space.s16) {
          VStack(alignment: .leading, spacing: Flint.Space.s8) {
            Text("Awning lights")
              .flintText(Flint.Typography.headingH3)
              .foregroundStyle(Flint.Colors.textHeading)
              .accessibilityAddTraits(.isHeader)
            Text("Warm white strip along the awning.")
              .flintText(Flint.Typography.bodySm)
              .foregroundStyle(Flint.Colors.textMuted)
            Toggle("Lights", isOn: $lightsOn)
              .flintText(Flint.Typography.bodyMd)
              .tint(Flint.Colors.actionPrimary)
              .frame(minHeight: Flint.Target.touch)
          }
          .padding(Flint.Space.s16)
          .background(Flint.Colors.surfaceDefault,
                      in: RoundedRectangle(cornerRadius: Flint.Radius.card))
          .overlay(RoundedRectangle(cornerRadius: Flint.Radius.card)
                     .stroke(Flint.Colors.borderDefault))

          Label("Rain after 6 PM. Pack the awning.", systemImage: "info.circle")
            .flintText(Flint.Typography.bodySm)
            .foregroundStyle(Flint.Colors.feedbackInfoText)
            .padding(Flint.Space.s12)
            .frame(maxWidth: .infinity, alignment: .leading)
            .background(Flint.Colors.feedbackInfoSurface,
                        in: RoundedRectangle(cornerRadius: Flint.Radius.control))

          VStack(alignment: .leading, spacing: Flint.Space.s8) {
            Text("Trip name")
              .flintText(Flint.Typography.labelDefault)
              .accessibilityHidden(true) // the field below carries the name
            TextField("Trip name", text: $tripName, prompt: Text("Big Bend, March"))
              .flintText(Flint.Typography.bodyMd)
              .padding(.horizontal, Flint.Space.s12)
              .frame(minHeight: Flint.Target.touch)
              .overlay(RoundedRectangle(cornerRadius: Flint.Radius.control)
                         .stroke(Flint.Colors.borderControl))
          }

          Button {
            withAnimation(Flint.Motion.animation(.emphasis, reduceMotion: reduceMotion)) {
              started = true
            }
            UIAccessibility.post(notification: .announcement, argument: "Trip started")
          } label: {
            Text("Start trip")
              .flintText(Flint.Typography.labelButton)
              .frame(maxWidth: .infinity, minHeight: Flint.Target.touch)
          }
          .foregroundStyle(Flint.Component.buttonPrimaryFg)
          .background(Flint.Component.buttonPrimaryBg,
                      in: RoundedRectangle(cornerRadius: Flint.Component.buttonRadius))

          if started {
            Text("Trip started")
              .flintText(Flint.Typography.labelDefault)
              .foregroundStyle(Flint.Colors.feedbackSuccessText)
              .frame(maxWidth: .infinity)
              .transition(.scale.combined(with: .opacity))
          }
        }
        .padding(Flint.Space.s16)
      }
      .background(Flint.Colors.surfacePage)
      .navigationTitle("Trips")
    }
  }
}`;
const uikitCode = `let bar = UINavigationBarAppearance()
bar.backgroundColor = Flint.UIColors.surfacePage
bar.titleTextAttributes = [.foregroundColor: Flint.UIColors.textHeading]`;
---
<Docs illo="phone" title="iOS and SwiftUI" crumb="Get started" lead="A Swift package for iOS 16 and macOS 13 or later, built from the same tokens as the web." toc={toc}>
  <h2 id="try">Try it</h2>
  <p>A Flint screen on a phone. Switch appearance, drag the text size up to the accessibility sizes, turn on Reduce Motion, and tab through the screen to read what VoiceOver says.</p>
  <PhoneDemo />
  <Code label="SwiftUI for this screen" code={screenCode} />

  <h2 id="add">Add the package</h2>
  <ol>
    <li>In Xcode, open File, then Add Package Dependencies.</li>
    <li>Enter <code>https://github.com/InnerSpark/flint</code> and pin it to a version.</li>
    <li>The repository is private, so add your GitHub account under Xcode, Settings, Accounts first.</li>
    <li>Bundle the Open Sans static fonts (Regular, Medium, SemiBold, Bold, ExtraBold) and list them under <code>UIAppFonts</code>.</li>
  </ol>

  <h2 id="use">Use it</h2>
  <Code label="SwiftUI" code={useCode} />

  <h2 id="reference">What is in the package</h2>
  <TableWrap label="Swift package contents">
    <table class="data">
      <thead><tr><th scope="col">Name</th><th scope="col">What it holds</th></tr></thead>
      <tbody>
        <tr><th scope="row"><code>Flint.Colors</code></th><td>Semantic colors. Each follows the system light and dark appearance.</td></tr>
        <tr><th scope="row"><code>Flint.UIColors</code></th><td>The same colors as dynamic <code>UIColor</code>, for UIKit APIs. <code>Flint.NSColors</code> on macOS.</td></tr>
        <tr><th scope="row"><code>Flint.Component</code></th><td>Button, input, checkbox and focus ring decisions.</td></tr>
        <tr><th scope="row"><code>Flint.Palette</code></th><td>The raw ladders. Reference only.</td></tr>
        <tr><th scope="row"><code>Flint.Typography</code></th><td>Type styles. Apply with <code>.flintText(_:)</code>; they scale with Dynamic Type.</td></tr>
        <tr><th scope="row"><code>Flint.Space</code>, <code>Flint.Radius</code></th><td>The spacing scale and radius, including <code>Radius.control</code> and <code>Radius.card</code>.</td></tr>
        <tr><th scope="row"><code>Flint.Control</code>, <code>Flint.IconSize</code></th><td>Control heights and icon sizes.</td></tr>
        <tr><th scope="row"><code>Flint.Target</code></th><td><code>minimum</code> is 24 (WCAG 2.5.8). Use <code>touch</code>, 44 (Apple HIG), for touch UI.</td></tr>
        <tr><th scope="row"><code>Flint.Motion</code></th><td>Durations and easing. <code>animation(_:duration:reduceMotion:)</code> returns nil when Reduce Motion is on.</td></tr>
      </tbody>
    </table>
  </TableWrap>

  <h2 id="uikit">UIKit colors</h2>
  <p><code>UIColor(Flint.Colors.x)</code> locks to light mode. For UIKit APIs such as navigation bar appearance, use <code>Flint.UIColors</code>, which switch with the appearance.</p>
  <Code label="Swift" code={uikitCode} />
  <Notice title="SwiftUI components are on the way">
    <p>The package ships tokens today. Buttons, notices, tags and controls proven in Bounder are moving into it (ASDS-38).</p>
  </Notice>
</Docs>
