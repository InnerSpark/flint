---
import Docs from '../../layouts/Docs.astro';
import Illustration from '../../components/Illustration.astro';
import { PRINCIPLE_GROUPS, PRINCIPLE_COUNT } from '../../data/principles.js';
import '../../styles/principles.css';
const toc = PRINCIPLE_GROUPS.map((g) => ({ id: g.id, text: g.title }));
const words = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten', 'eleven', 'twelve', 'thirteen', 'fourteen', 'fifteen'];
const say = (n) => words[n] ?? String(n);
---
<Docs
  title="Principles"
  lead={`${say(PRINCIPLE_COUNT).replace(/^./, (c) => c.toUpperCase())} rules in ${say(PRINCIPLE_GROUPS.length)} groups. When a decision isn't covered by a token or a component, start here. Each one has its own page: why it exists, what it looks like in practice, where the build enforces it and every page that follows it.`}
  toc={toc}
  wide
>
  <script type="application/json" id="principle-ids" set:html={JSON.stringify(PRINCIPLE_GROUPS.flatMap((g) => g.items.map((p) => p.id)))} />
  <div class="principles-hero"><Illustration name="hero" /></div>

  {PRINCIPLE_GROUPS.map((g) => (
    <section class="principle-group" aria-labelledby={g.id}>
      <div class="principle-group-head">
        <div>
          <h2 id={g.id}>{g.title}</h2>
          <p class="principle-group-lead">{g.lead}</p>
        </div>
        <div class="principle-illo"><Illustration name={g.illustration} /></div>
      </div>
      <ul class="link-list principle-links">
        {g.items.map((p) => <li><a href={`/principles/${p.id}/`}><strong>{p.title}</strong><span>{p.why}</span></a></li>)}
      </ul>
    </section>
  ))}
</Docs>
<script>
  // Old links pointed at /principles/#<principle>. Each principle has its own page now (ASDS-101).
  const ids = new Set(JSON.parse(document.getElementById('principle-ids').textContent));
  const id = decodeURIComponent(location.hash.slice(1));
  if (ids.has(id)) location.replace(`/principles/${id}/`);
</script>
