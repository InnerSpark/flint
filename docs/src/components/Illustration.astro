---
// Flint spot illustrations (ASDS-56). Decorative: aria-hidden, no text in the art.
// Colours come from styles/illustration.css, which maps Flint tokens to facet roles.
import '../styles/illustration.css';
const { name, class: cls = '' } = Astro.props;

// The brand shard (from brand/flint-icon.svg, 64 grid), placed at x,y and scaled by s.
const shard = (x, y, s) => `<g transform="translate(${x} ${y}) scale(${s})">
<polygon class="i-lit" points="33,7 55,25 32,28"/><polygon class="i-face" points="55,25 41,57 32,28"/>
<polygon class="i-mid" points="41,57 21,55 32,28"/><polygon class="i-deep" points="21,55 11,23 32,28"/>
<polygon class="i-shade" points="11,23 33,7 32,28"/></g>`;
// The struck spark, centred on cx,cy.
const spark = (cx, cy, s = 1) => `<g class="i-twinkle" transform="translate(${cx} ${cy}) scale(${s}) translate(-54 -11)">
<path class="i-spark" d="M54 6 Q55 11 54 16 Q53 11 54 6 Z"/><path class="i-spark" d="M49 11 Q54 10 59 11 Q54 12 49 11 Z"/>
<circle class="i-spark" cx="59" cy="18" r="1.4"/></g>`;

const art = {
  // How it looks: the content leads in a quiet frame, with one action.
  looks: { box: '0 0 160 120', body: `
<rect class="i-ground" width="160" height="120" rx="12"/>
<rect class="i-card" x="20" y="18" width="120" height="84" rx="8"/>
<rect class="i-ground" x="30" y="28" width="58" height="62" rx="4"/>
${shard(37, 33, 0.7)}
<rect class="i-ink" x="98" y="32" width="32" height="4" rx="2"/>
<rect class="i-ink" x="98" y="42" width="24" height="4" rx="2"/>
<rect class="i-ink" x="98" y="52" width="28" height="4" rx="2"/>
<rect class="i-action" x="98" y="76" width="32" height="14" rx="7"/>
${spark(140, 16, 1.6)}` },

  // How it behaves: a key press moves focus, and the focus is plain to see.
  behaves: { box: '0 0 160 120', body: `
<rect class="i-ground" width="160" height="120" rx="12"/>
<rect class="i-card" x="16" y="60" width="40" height="32" rx="6"/>
<path class="i-ink-stroke" d="M26 76h14m-5-5l5 5l-5 5M44 70v12"/>
<path class="i-dash" d="M58 76C78 76 78 50 92 50"/>
<rect class="i-action" x="98" y="40" width="46" height="20" rx="6"/>
<rect class="i-focus" x="93" y="35" width="56" height="30" rx="10"/>
<rect class="i-card" x="98" y="74" width="46" height="12" rx="4"/>
<rect class="i-card" x="98" y="92" width="46" height="12" rx="4"/>
${shard(18, 12, 0.55)}
${spark(58, 22, 1.2)}` },

  // How it talks: short, plain words that name the action.
  talks: { box: '0 0 160 120', body: `
<rect class="i-ground" width="160" height="120" rx="12"/>
<path class="i-card" d="M32 20h80a10 10 0 0 1 10 10v38a10 10 0 0 1-10 10h-62l-14 14v-14h-4a10 10 0 0 1-10-10v-38a10 10 0 0 1 10-10z"/>
<rect class="i-ink" x="34" y="32" width="64" height="4" rx="2"/>
<rect class="i-ink" x="34" y="42" width="44" height="4" rx="2"/>
<rect class="i-action" x="34" y="56" width="42" height="12" rx="6"/>
${shard(112, 64, 0.62)}
${spark(140, 30, 1.6)}` },

  // Tiers: the shard strikes a spark that lights the three token tiers, stacked like cards.
  tiers: { box: '0 0 360 280', body: `
<rect class="i-ground" width="360" height="280" rx="16"/>
${shard(14, 84, 1.7)}
${spark(108, 70, 2.2)}
<path class="i-dash" d="M120 84C150 70 150 56 176 52"/>
<rect class="i-card" x="168" y="30" width="170" height="62" rx="10"/>
<circle class="i-lit" cx="194" cy="61" r="9"/><circle class="i-face" cx="220" cy="61" r="9"/><circle class="i-shade" cx="246" cy="61" r="9"/><circle class="i-mid" cx="272" cy="61" r="9"/><circle class="i-deep" cx="298" cy="61" r="9"/>
<rect class="i-card" x="148" y="108" width="170" height="62" rx="10"/>
<rect class="i-ink" x="166" y="124" width="70" height="6" rx="3"/><rect class="i-ink" x="166" y="138" width="46" height="6" rx="3"/>
<rect class="i-action" x="250" y="128" width="50" height="22" rx="11"/>
<rect class="i-card" x="128" y="186" width="170" height="62" rx="10"/>
<rect class="i-action" x="150" y="204" width="80" height="26" rx="7"/>
<rect class="i-focus" x="145" y="199" width="90" height="36" rx="11"/>
<path class="i-ink-stroke" d="M252 210l7 7 13-14"/>` },

  // ---------- Spots for Get started and the Guides (160 x 120), beside the page lead ----------
  // Get started: the package opens and the shard comes out.
  start: { box: '0 0 160 120', body: `
<rect class="i-ground" width="160" height="120" rx="12"/>
<path class="i-card" d="M40 62l40-14 40 14v34l-40 14-40-14z"/>
<path class="i-line" d="M40 62l40 14 40-14M80 76v34"/>
<path class="i-card" d="M40 62l-12-16 40-14 12 16z"/><path class="i-card" d="M120 62l12-16-40-14-12 16z"/>
${shard(54, 6, 0.8)}
${spark(122, 22, 1.4)}` },

  // Web and CSS: a browser window, a rule in braces, the facets as a swatch row.
  web: { box: '0 0 160 120', body: `
<rect class="i-ground" width="160" height="120" rx="12"/>
<rect class="i-card" x="16" y="18" width="128" height="86" rx="8"/>
<path class="i-line" d="M16 34h128"/>
<circle class="i-ink" cx="27" cy="26" r="2.5"/><circle class="i-ink" cx="36" cy="26" r="2.5"/><circle class="i-ink" cx="45" cy="26" r="2.5"/>
<path class="i-ink-stroke" d="M34 46c-6 0-6 4-6 8s-3 5-5 5c2 0 5 1 5 5s0 8 6 8"/>
<path class="i-ink-stroke" d="M78 46c6 0 6 4 6 8s3 5 5 5c-2 0-5 1-5 5s0 8-6 8"/>
<rect class="i-ink" x="40" y="52" width="30" height="4" rx="2"/><rect class="i-ink" x="40" y="62" width="22" height="4" rx="2"/>
<rect class="i-lit" x="98" y="46" width="14" height="14" rx="3"/><rect class="i-face" x="116" y="46" width="14" height="14" rx="3"/>
<rect class="i-mid" x="98" y="64" width="14" height="14" rx="3"/><rect class="i-deep" x="116" y="64" width="14" height="14" rx="3"/>
<rect class="i-action" x="40" y="84" width="40" height="12" rx="6"/>
${spark(146, 14, 1.3)}` },

  // React: components nested in components, each built from the same pieces.
  react: { box: '0 0 160 120', body: `
<rect class="i-ground" width="160" height="120" rx="12"/>
<rect class="i-card" x="14" y="16" width="132" height="88" rx="10"/>
<rect class="i-card" x="26" y="30" width="52" height="62" rx="6"/>
<rect class="i-card" x="86" y="30" width="48" height="28" rx="6"/>
<rect class="i-card" x="86" y="64" width="48" height="28" rx="6"/>
<rect class="i-ink" x="34" y="40" width="30" height="4" rx="2"/><rect class="i-ink" x="34" y="50" width="22" height="4" rx="2"/>
<rect class="i-action" x="34" y="72" width="34" height="12" rx="6"/>
<rect class="i-action" x="94" y="38" width="32" height="12" rx="4"/><rect class="i-focus" x="90" y="34" width="40" height="20" rx="7"/>
<path class="i-ink-stroke" d="M96 78l5 5 9-10"/>
${spark(140, 14, 1.3)}` },

  // MUI: one theme, every component picks up its colors.
  theme: { box: '0 0 160 120', body: `
<rect class="i-ground" width="160" height="120" rx="12"/>
<g transform="rotate(-10 52 70)"><rect class="i-card" x="22" y="28" width="44" height="74" rx="6"/><rect class="i-lit" x="28" y="34" width="32" height="14" rx="3"/><rect class="i-face" x="28" y="52" width="32" height="14" rx="3"/><rect class="i-mid" x="28" y="70" width="32" height="14" rx="3"/></g>
<rect class="i-card" x="62" y="22" width="44" height="74" rx="6"/><rect class="i-shade" x="68" y="28" width="32" height="14" rx="3"/><rect class="i-deep" x="68" y="46" width="32" height="14" rx="3"/><rect class="i-action" x="68" y="64" width="32" height="14" rx="3"/>
<path class="i-dash" d="M108 58c14 0 18-10 26-14"/>
<rect class="i-card" x="112" y="62" width="34" height="34" rx="6"/><rect class="i-action" x="118" y="74" width="22" height="10" rx="5"/>
${spark(138, 30, 1.3)}` },

  // shadcn/ui: components you copy in, stacked, all pointing at the same tokens.
  layers: { box: '0 0 160 120', body: `
<rect class="i-ground" width="160" height="120" rx="12"/>
<rect class="i-card" x="44" y="18" width="92" height="56" rx="8"/>
<rect class="i-card" x="34" y="32" width="92" height="56" rx="8"/>
<rect class="i-card" x="24" y="46" width="92" height="56" rx="8"/>
<rect class="i-ink" x="34" y="58" width="44" height="4" rx="2"/><rect class="i-ink" x="34" y="68" width="30" height="4" rx="2"/>
<rect class="i-action" x="34" y="82" width="36" height="12" rx="6"/>
${shard(112, 74, 0.5)}
${spark(140, 16, 1.3)}` },

  // iOS and SwiftUI: the same pieces on a phone.
  phone: { box: '0 0 160 120', body: `
<rect class="i-ground" width="160" height="120" rx="12"/>
<rect class="i-card" x="56" y="10" width="48" height="100" rx="10"/>
<rect class="i-ink" x="72" y="16" width="16" height="3" rx="1.5"/>
<rect class="i-lit" x="62" y="26" width="36" height="22" rx="4"/>
<rect class="i-ink" x="62" y="54" width="28" height="4" rx="2"/><rect class="i-ink" x="62" y="62" width="20" height="4" rx="2"/>
<rect class="i-action" x="62" y="88" width="36" height="12" rx="6"/>
${shard(10, 50, 0.6)}
${spark(122, 30, 1.6)}` },

  // Figma: a frame on the canvas, with handles, and the cursor placing a component.
  figma: { box: '0 0 160 120', body: `
<rect class="i-ground" width="160" height="120" rx="12"/>
<rect class="i-card" x="24" y="22" width="88" height="70" rx="4"/>
<rect class="i-focus" x="40" y="44" width="52" height="24" rx="3"/>
<rect class="i-action" x="44" y="48" width="44" height="16" rx="8"/>
<rect class="i-card" x="37" y="41" width="6" height="6"/><rect class="i-card" x="89" y="41" width="6" height="6"/><rect class="i-card" x="37" y="65" width="6" height="6"/><rect class="i-card" x="89" y="65" width="6" height="6"/>
<path class="i-deep" d="M104 74l20 8-9 3-4 9z"/>
<rect class="i-ink" x="30" y="78" width="36" height="4" rx="2"/>
${spark(136, 24, 1.5)}` },

  // Accessibility: a focus ring you can see, a target that is big enough, a key that reaches it.
  access: { box: '0 0 160 120', body: `
<rect class="i-ground" width="160" height="120" rx="12"/>
<rect class="i-card" x="14" y="72" width="34" height="30" rx="6"/>
<path class="i-ink-stroke" d="M22 87h14m-5-5l5 5l-5 5M40 81v12"/>
<path class="i-dash" d="M50 86c18 0 18-30 38-30"/>
<rect class="i-action" x="92" y="44" width="48" height="24" rx="6"/>
<rect class="i-focus" x="87" y="39" width="58" height="34" rx="10"/>
<rect class="i-line" x="82" y="34" width="68" height="44" rx="4" stroke-dasharray="3 4"/>
${shard(16, 12, 0.6)}
${spark(146, 22, 1.3)}` },

  // Contributing: a change, and the checks it has to pass.
  checks: { box: '0 0 160 120', body: `
<rect class="i-ground" width="160" height="120" rx="12"/>
<rect class="i-card" x="40" y="14" width="80" height="94" rx="8"/>
<path class="i-ink-stroke" d="M52 36l5 5 9-10M52 60l5 5 9-10M52 84l5 5 9-10"/>
<rect class="i-ink" x="74" y="34" width="34" height="4" rx="2"/><rect class="i-ink" x="74" y="58" width="28" height="4" rx="2"/><rect class="i-ink" x="74" y="82" width="32" height="4" rx="2"/>
${shard(110, 64, 0.62)}
${spark(28, 26, 1.5)}` },

  // Usage rules: do and don't, side by side.
  rules: { box: '0 0 160 120', body: `
<rect class="i-ground" width="160" height="120" rx="12"/>
<rect class="i-card" x="16" y="22" width="60" height="78" rx="8"/><rect class="i-card" x="84" y="22" width="60" height="78" rx="8"/>
<rect class="i-action" x="26" y="62" width="40" height="14" rx="7"/>
<rect class="i-lit" x="94" y="62" width="40" height="14" rx="7"/><rect class="i-shade" x="94" y="82" width="40" height="8" rx="4"/>
<path class="i-ink-stroke" d="M38 38l6 6 12-12"/>
<path class="i-ink-stroke" d="M106 32l12 12M118 32l-12 12"/>
${spark(140, 14, 1.3)}` },

  // Hero: the shard is struck, the spark lights the three ways Flint shows up.
  hero: { box: '0 0 640 160', body: `
<rect class="i-ground" width="640" height="160" rx="16"/>
${shard(24, 8, 2.2)}
<path class="i-dash" d="M150 46C210 10 250 10 300 40"/>
${spark(156, 34, 2.4)}
<circle class="i-spark" cx="176" cy="24" r="2.5"/><circle class="i-spark" cx="194" cy="18" r="1.8"/>
<g transform="translate(300 34)">
  <rect class="i-card" width="92" height="92" rx="10"/>
  <rect class="i-ink" x="14" y="16" width="48" height="5" rx="2.5"/><rect class="i-ink" x="14" y="28" width="34" height="5" rx="2.5"/>
  <rect class="i-action" x="14" y="62" width="44" height="16" rx="8"/>
</g>
<g transform="translate(410 34)">
  <rect class="i-card" width="92" height="92" rx="10"/>
  <rect class="i-action" x="18" y="36" width="56" height="20" rx="6"/>
  <rect class="i-focus" x="13" y="31" width="66" height="30" rx="10"/>
</g>
<g transform="translate(520 34)">
  <rect class="i-card" width="92" height="92" rx="10"/>
  <path class="i-ink-stroke" d="M22 26h48a8 8 0 0 1 8 8v18a8 8 0 0 1-8 8h-34l-10 10v-10h-4a8 8 0 0 1-8-8v-18a8 8 0 0 1 8-8z"/>
  <rect class="i-ink" x="26" y="36" width="32" height="4" rx="2"/><rect class="i-ink" x="26" y="46" width="22" height="4" rx="2"/>
</g>` },
};
const a = art[name];
if (!a) throw new Error(`No illustration named ${name}`);
---
<svg class={`illo ${cls}`} viewBox={a.box} aria-hidden="true" focusable="false" set:html={a.body} />
