---
// One color as a chip: the ink on top (light and dark halves for a semantic token), then the name,
// what it points at, the values and its contrast. The whole chip is a button that copies the CSS
// variable; Docs.astro announces the copy. Visible text reads in order, with sr-only words where a
// symbol carries meaning on screen.
import { grade } from '../lib/flint.js';
const { name, token, cssVar, light, dark, refs = [], ratios = [], against } = Astro.props;
const shown = ratios.filter((r) => r != null);
const worst = shown.length ? Math.min(...shown) : null;
const fmt = (r) => r.toFixed(1);
---
<li class="chip-item" data-token={token}>
  <button type="button" class="chip" data-copy-text={`var(${cssVar})`} aria-describedby="chip-hint">
    <span class="chip-ink" aria-hidden="true">
      <span style={`background:${light}`}>{dark && <b>Light</b>}</span>
      {dark && <span style={`background:${dark}`}><b>Dark</b></span>}
    </span>
    <span class="chip-name">{name.split('.').map((part, i) => <>{i > 0 && <>.<wbr /></>}{part}</>)}</span>
    {refs.length > 0 && (
      <span class="chip-ref">
        {refs.length === 2 && refs[0] !== refs[1]
          ? <><span class="flint-sr-only">light, </span>{refs[0]}<span aria-hidden="true"> · </span><span class="flint-sr-only">, dark, </span>{refs[1]}</>
          : refs[0]}
      </span>
    )}
    <span class="chip-hex">{dark ? <>{light}<span aria-hidden="true"> / </span><span class="flint-sr-only">, </span>{dark}</> : light}</span>
    {worst != null && (
      <span class="chip-meta">
        <span class={`chip-badge${worst < 3 ? ' is-low' : ''}`}>
          {grade(worst)}<span class="flint-sr-only">,</span><span aria-hidden="true"> ·</span> {shown.length === 2 ? <><span class="flint-sr-only">light </span>{fmt(shown[0])}<span aria-hidden="true"> / </span><span class="flint-sr-only">, dark </span>{fmt(shown[1])}:1</> : `${fmt(shown[0])}:1`}
        </span>
        <span class="chip-mark" aria-hidden="true">Flint</span>
      </span>
    )}
    {worst != null && <span class="chip-against">{against}</span>}
  </button>
</li>
