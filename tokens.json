{
  "color": {
    "blue":   { "50": "#eff6ff", "100": "#dbeafe", "200": "#bfdbfe", "300": "#93c5fd", "400": "#60a5fa", "500": "#2767cc", "600": "#1a5fa8", "700": "#1550a0", "800": "#0d3b6e", "900": "#0d2b45" },
    "sky":    { "50": "#f0f9ff", "100": "#e0f2fe", "200": "#bae6fd", "300": "#7dd3fc", "400": "#38bdf8", "500": "#0ea5e9", "600": "#0284c7", "700": "#0369a1", "800": "#075985", "900": "#0c4a6e" },
    "gray":   { "50": "#f8fafc", "100": "#f1f5f9", "200": "#e2e8f0", "300": "#cbd5e1", "350": "#9fadc1", "400": "#94a3b8", "450": "#8492a6", "500": "#64748b", "550": "#5f6f84", "600": "#475569", "700": "#334155", "800": "#1e293b", "900": "#0f172a" },
    "ink":    { "50": "#f0f6fc", "100": "#c9d1d9", "200": "#aeb8c2", "300": "#9aa4af", "400": "#828b95", "500": "#6e7681", "600": "#545d68", "700": "#21262d", "800": "#161b22", "900": "#0d1117", "950": "#010409" },
    "green":  { "50": "#f0fdf4", "100": "#dcfce7", "200": "#bbf7d0", "300": "#86efac", "400": "#4ade80", "500": "#22c55e", "600": "#16a34a", "700": "#15803d", "800": "#166534", "900": "#14532d" },
    "amber":  { "50": "#fffbeb", "100": "#fef3c7", "200": "#fde68a", "300": "#fcd34d", "400": "#fbbf24", "500": "#f59e0b", "600": "#d97706", "700": "#b45309", "800": "#92400e", "900": "#78350f" },
    "red":    { "50": "#fef2f2", "100": "#fee2e2", "200": "#fecaca", "300": "#fca5a5", "400": "#f87171", "500": "#ef4444", "600": "#dc2626", "700": "#b91c1c", "800": "#991b1b", "900": "#7f1d1d", "950": "#450a0a" },
    "violet": { "50": "#f5f3ff", "100": "#ede9fe", "200": "#ddd6fe", "300": "#c4b5fd", "400": "#a78bfa", "500": "#8b5cf6", "600": "#7c3aed", "700": "#6d28d9", "800": "#5b21b6", "900": "#4c1d95" },
    "white": "#ffffff",
    "black": "#0a0f1a"
  },
  "space": { "0": 0, "2": 2, "4": 4, "8": 8, "12": 12, "16": 16, "24": 24, "32": 32, "40": 40, "48": 48, "64": 64 },
  "radius": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "pill": 9999, "control": "{radius.sm}", "card": "{radius.md}", "cardLg": "{radius.lg}" },
  "fontFamily": { "sans": "'Open Sans', sans-serif", "prose": "'Open Sans', sans-serif", "mono": "ui-monospace, SFMono-Regular, Menlo, monospace" },
  "fontWeight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "extrabold": 800 },
  "fontSize": { "xs": 12, "sm": 14, "md": 16, "lg": 18, "xl": 24, "2xl": 30, "3xl": 36, "4xl": 48 },
  "lineHeight": { "tight": 1.2, "snug": 1.35, "normal": 1.5, "relaxed": 1.75 },
  "control": { "sm": 32, "md": 40 },
  "iconSize": { "sm": 16, "md": 20, "lg": 24 },
  "targetMin": 24,
  "density": {
    "comfortable": {
      "inset": { "sm": 8, "md": 12, "lg": 16, "xl": 24 },
      "gap": { "sm": 8, "md": 12, "lg": 16 }
    },
    "compact": {
      "inset": { "sm": 4, "md": 8, "lg": 12, "xl": 16 },
      "gap": { "sm": 4, "md": 8, "lg": 12 }
    }
  },
  "shadow": {
    "card": "0 2px 8px rgba(0, 0, 0, 0.08)",
    "popover": "0 4px 16px rgba(0, 0, 0, 0.12)",
    "dialog": "0 8px 32px rgba(0, 0, 0, 0.16)",
    "raised": "0 10px 30px rgba(13, 43, 69, 0.12)"
  },
  "shadowDark": {
    "card": "0 0 0 1px rgba(255, 255, 255, 0.04), 0 2px 8px rgba(0, 0, 0, 0.4)",
    "popover": "0 0 0 1px rgba(255, 255, 255, 0.05), 0 6px 20px rgba(0, 0, 0, 0.5)",
    "dialog": "0 0 0 1px rgba(255, 255, 255, 0.06), 0 12px 40px rgba(0, 0, 0, 0.6)",
    "raised": "0 0 0 1px rgba(255, 255, 255, 0.05), 0 10px 30px rgba(0, 0, 0, 0.5)"
  },
  "typography": {
    "display":        { "fontFamily": "'Open Sans', sans-serif", "fontSize": 48, "fontWeight": 700, "lineHeight": 1.2, "letterSpacing": "-1.2px" },
    "displayXl":      { "fontFamily": "'Open Sans', sans-serif", "fontSize": 56, "fontWeight": 800, "lineHeight": 1.08, "letterSpacing": "-2px" },
    "headingH1":      { "fontFamily": "'Open Sans', sans-serif", "fontSize": 36, "fontWeight": 700, "lineHeight": 1.2, "letterSpacing": "-0.8px" },
    "headingH2":      { "fontFamily": "'Open Sans', sans-serif", "fontSize": 24, "fontWeight": 700, "lineHeight": 1.3, "letterSpacing": "-0.4px" },
    "headingH3":      { "fontFamily": "'Open Sans', sans-serif", "fontSize": 18, "fontWeight": 700, "lineHeight": 1.4, "letterSpacing": "0" },
    "bodyLg":         { "fontFamily": "'Open Sans', sans-serif", "fontSize": 18, "fontWeight": 400, "lineHeight": 1.6, "letterSpacing": "0" },
    "bodyMd":         { "fontFamily": "'Open Sans', sans-serif", "fontSize": 16, "fontWeight": 400, "lineHeight": 1.5, "letterSpacing": "0" },
    "bodySm":         { "fontFamily": "'Open Sans', sans-serif", "fontSize": 14, "fontWeight": 400, "lineHeight": 1.5, "letterSpacing": "0" },
    "labelButton":    { "fontFamily": "'Open Sans', sans-serif", "fontSize": 14, "fontWeight": 700, "lineHeight": 1, "letterSpacing": "0" },
    "labelDefault":   { "fontFamily": "'Open Sans', sans-serif", "fontSize": 14, "fontWeight": 600, "lineHeight": 1.4, "letterSpacing": "0" },
    "labelCaption":   { "fontFamily": "'Open Sans', sans-serif", "fontSize": 12, "fontWeight": 600, "lineHeight": 1.3, "letterSpacing": "0.5px" },
    "labelKicker":    { "fontFamily": "'Open Sans', sans-serif", "fontSize": 12, "fontWeight": 700, "lineHeight": 1.2, "letterSpacing": "1.68px" },
    "labelFinePrint": { "fontFamily": "'Open Sans', sans-serif", "fontSize": 12, "fontWeight": 700, "lineHeight": 1.2, "letterSpacing": "0.55px" },
    "labelHelper":    { "fontFamily": "'Open Sans', sans-serif", "fontSize": 12, "fontWeight": 400, "lineHeight": 1.4, "letterSpacing": "0" }
  },
  "motion": {
    "duration": { "instant": "0ms", "fast": "120ms", "base": "200ms", "slow": "320ms" },
    "easing": { "standard": "cubic-bezier(0.2, 0, 0, 1)", "entrance": "cubic-bezier(0, 0, 0.2, 1)", "exit": "cubic-bezier(0.4, 0, 1, 1)" }
  },
  "zIndex": { "base": 0, "dropdown": 1000, "sticky": 1100, "overlay": 1200, "modal": 1300, "popover": 1400, "toast": 1500 },
  "breakpoint": { "xs": 0, "sm": 640, "md": 768, "lg": 900, "xl": 1200 },
  "semantic": {
    "light": {
      "surface": { "page": "{color.gray.50}", "default": "{color.white}", "subtle": "{color.gray.100}", "inverse": "{color.blue.900}", "code": "{color.gray.800}" },
      "text": { "heading": "{color.blue.900}", "default": "{color.gray.800}", "muted": "{color.gray.700}", "placeholder": "{color.gray.700}", "link": "{color.blue.700}", "inverse": "{color.white}", "inverseMuted": "{color.gray.300}", "onCode": "{color.white}" },
      "action": { "primary": "{color.blue.700}", "primaryHover": "{color.blue.800}", "primaryPressed": "{color.blue.900}", "onPrimary": "{color.white}", "secondary": "{color.sky.400}", "focusRing": "{color.blue.700}", "danger": "{color.red.800}", "dangerHover": "{color.red.900}", "dangerPressed": "{color.red.950}", "onDanger": "{color.white}", "disabled": "{color.gray.500}", "disabledBg": "{color.gray.100}" },
      "border": { "default": "{color.gray.200}", "control": "{color.gray.500}", "controlHover": "{color.gray.600}", "strong": "{color.gray.300}", "focus": "{color.blue.700}", "error": "{color.red.600}", "disabled": "{color.gray.200}" },
      "feedback": {
        "success": { "surface": "{color.green.50}", "border": "{color.green.200}", "solid": "{color.green.800}", "text": "{color.green.900}", "onSolid": "{color.white}" },
        "warning": { "surface": "{color.amber.50}", "border": "{color.amber.200}", "solid": "{color.amber.800}", "text": "{color.amber.900}", "onSolid": "{color.white}" },
        "error": { "surface": "{color.red.50}", "border": "{color.red.200}", "solid": "{color.red.800}", "text": "{color.red.900}", "onSolid": "{color.white}" },
        "info": { "surface": "{color.blue.50}", "border": "{color.blue.100}", "solid": "{color.blue.700}", "text": "{color.blue.800}", "onSolid": "{color.white}" }
      },
      "accent": { "aaaSurface": "{color.violet.100}", "aaaSolid": "{color.violet.700}", "aaaText": "{color.violet.800}", "onAaa": "{color.white}", "cyan": "{color.sky.900}" },
      "selected": { "surface": "{color.blue.50}", "text": "{color.blue.700}" },
      "chart": { "1": "{color.blue.600}", "2": "{color.amber.700}", "3": "{color.violet.600}", "4": "{color.green.700}", "5": "{color.red.600}" },
      "overlayScrim": "rgba(15, 23, 42, 0.5)"
    },
    "dark": {
      "surface": { "page": "{color.ink.900}", "default": "{color.ink.800}", "subtle": "{color.ink.700}", "inverse": "{color.gray.50}", "code": "{color.ink.950}" },
      "text": { "heading": "{color.ink.50}", "default": "{color.ink.100}", "muted": "{color.ink.200}", "placeholder": "{color.ink.200}", "link": "{color.blue.300}", "inverse": "{color.ink.900}", "inverseMuted": "{color.gray.700}", "onCode": "{color.white}" },
      "action": { "primary": "{color.blue.300}", "primaryHover": "{color.blue.200}", "primaryPressed": "{color.blue.100}", "onPrimary": "{color.ink.900}", "secondary": "{color.sky.400}", "focusRing": "{color.blue.400}", "danger": "{color.red.300}", "dangerHover": "{color.red.200}", "dangerPressed": "{color.red.100}", "onDanger": "{color.ink.900}", "disabled": "{color.ink.400}", "disabledBg": "{color.ink.700}" },
      "border": { "default": "{color.ink.500}", "control": "{color.ink.500}", "controlHover": "{color.ink.300}", "strong": "{color.ink.200}", "focus": "{color.blue.400}", "error": "{color.red.400}", "disabled": "{color.ink.600}" },
      "feedback": {
        "success": { "surface": "{color.green.900}", "border": "{color.green.800}", "solid": "{color.green.400}", "text": "{color.green.200}", "onSolid": "{color.ink.900}" },
        "warning": { "surface": "{color.amber.900}", "border": "{color.amber.800}", "solid": "{color.amber.400}", "text": "{color.amber.200}", "onSolid": "{color.ink.900}" },
        "error": { "surface": "{color.red.900}", "border": "{color.red.800}", "solid": "{color.red.300}", "text": "{color.red.100}", "onSolid": "{color.ink.900}" },
        "info": { "surface": "{color.blue.900}", "border": "{color.blue.800}", "solid": "{color.blue.300}", "text": "{color.blue.300}", "onSolid": "{color.ink.900}" }
      },
      "accent": { "aaaSurface": "{color.violet.900}", "aaaSolid": "{color.violet.300}", "aaaText": "{color.violet.200}", "onAaa": "{color.ink.900}", "cyan": "{color.sky.300}" },
      "selected": { "surface": "{color.blue.800}", "text": "{color.blue.200}" },
      "chart": { "1": "{color.blue.400}", "2": "{color.amber.400}", "3": "{color.violet.400}", "4": "{color.green.400}", "5": "{color.red.400}" },
      "overlayScrim": "rgba(0, 0, 0, 0.6)"
    }
  },
  "component": {
    "link": { "fg": "{semantic.text.link}" },
    "button": {
      "radius": "{radius.control}",
      "height": "{control.md}",
      "primary": { "bg": "{semantic.action.primary}", "bgHover": "{semantic.action.primaryHover}", "bgPressed": "{semantic.action.primaryPressed}", "fg": "{semantic.action.onPrimary}" },
      "secondary": { "bg": "{semantic.surface.default}", "bgHover": "{semantic.surface.subtle}", "fg": "{semantic.action.primary}", "border": "{semantic.border.control}" },
      "danger": { "bg": "{semantic.action.danger}", "bgHover": "{semantic.action.dangerHover}", "bgPressed": "{semantic.action.dangerPressed}", "fg": "{semantic.action.onDanger}" },
      "text": { "bgHover": "{semantic.surface.subtle}", "fg": "{semantic.text.link}" },
      "disabled": { "bg": "{semantic.action.disabledBg}", "fg": "{semantic.action.disabled}", "border": "{semantic.border.disabled}" }
    },
    "field": { "labelFg": "{semantic.text.heading}", "helperFg": "{semantic.text.muted}", "errorFg": "{semantic.feedback.error.text}" },
    "input": {
      "radius": "{radius.control}",
      "height": "{control.md}",
      "bg": "{semantic.surface.default}",
      "bgReadOnly": "{semantic.surface.subtle}",
      "fg": "{semantic.text.default}",
      "placeholder": "{semantic.text.placeholder}",
      "border": "{semantic.border.control}",
      "borderHover": "{semantic.border.controlHover}",
      "borderFocus": "{semantic.border.focus}",
      "borderError": "{semantic.border.error}"
    },
    "checkbox": {
      "size": "{targetMin}",
      "radius": "{radius.xs}",
      "border": "{semantic.border.control}",
      "borderHover": "{semantic.border.controlHover}", "borderError": "{semantic.border.error}",
      "checkedBg": "{semantic.action.primary}",
      "checkedFg": "{semantic.action.onPrimary}",
      "disabled": "{semantic.action.disabled}",
      "disabledBg": "{semantic.action.disabledBg}"
    },
    "radio": {
      "size": "{targetMin}",
      "border": "{semantic.border.control}",
      "borderHover": "{semantic.border.controlHover}", "borderError": "{semantic.border.error}",
      "checkedBg": "{semantic.action.primary}",
      "checkedFg": "{semantic.action.onPrimary}",
      "disabled": "{semantic.action.disabled}",
      "disabledBg": "{semantic.action.disabledBg}"
    },
    "switch": {
      "track": "{semantic.border.control}",
      "trackChecked": "{semantic.action.primary}",
      "trackDisabled": "{semantic.action.disabledBg}",
      "thumb": "{color.white}",
      "thumbChecked": "{semantic.action.onPrimary}"
    },
    "select": {
      "radius": "{radius.control}",
      "height": "{control.md}",
      "bg": "{semantic.surface.default}",
      "fg": "{semantic.text.default}",
      "placeholder": "{semantic.text.placeholder}",
      "icon": "{semantic.text.muted}",
      "border": "{semantic.border.control}",
      "borderHover": "{semantic.border.controlHover}",
      "borderFocus": "{semantic.border.focus}",
      "borderError": "{semantic.border.error}",
      "menuRadius": "{radius.sm}"
    },
    "chip": {
      "radius": "{radius.pill}",
      "fontWeight": "{fontWeight.semibold}",
      "neutral": {
        "bg": "{semantic.surface.subtle}",
        "fg": "{semantic.text.default}",
        "border": "{semantic.border.control}"
      },
      "success": {
        "bg": "{semantic.feedback.success.surface}",
        "fg": "{semantic.feedback.success.text}",
        "border": "{semantic.feedback.success.solid}"
      },
      "warning": {
        "bg": "{semantic.feedback.warning.surface}",
        "fg": "{semantic.feedback.warning.text}",
        "border": "{semantic.feedback.warning.solid}"
      },
      "error": {
        "bg": "{semantic.feedback.error.surface}",
        "fg": "{semantic.feedback.error.text}",
        "border": "{semantic.feedback.error.solid}"
      },
      "info": {
        "bg": "{semantic.feedback.info.surface}",
        "fg": "{semantic.feedback.info.text}",
        "border": "{semantic.feedback.info.solid}"
      }
    },
    "badge": {
      "radius": "{radius.pill}",
      "fontWeight": "{fontWeight.semibold}",
      "fontSize": "{fontSize.xs}",
      "neutral": {
        "bg": "{semantic.surface.subtle}",
        "fg": "{semantic.text.default}"
      },
      "success": {
        "bg": "{semantic.feedback.success.surface}",
        "fg": "{semantic.feedback.success.text}"
      },
      "warning": {
        "bg": "{semantic.feedback.warning.surface}",
        "fg": "{semantic.feedback.warning.text}"
      },
      "error": {
        "bg": "{semantic.feedback.error.surface}",
        "fg": "{semantic.feedback.error.text}"
      },
      "info": {
        "bg": "{semantic.feedback.info.surface}",
        "fg": "{semantic.feedback.info.text}"
      }
    },
    "skipLink": {
      "bg": "{semantic.action.primary}",
      "fg": "{semantic.action.onPrimary}",
      "radius": "{radius.sm}"
    },
    "icon": {
      "sm": "{iconSize.sm}",
      "md": "{iconSize.md}",
      "lg": "{iconSize.lg}",
      "fg": "{semantic.text.default}",
      "fgMuted": "{semantic.text.muted}"
    },
    "focus": { "ring": { "color": "{semantic.action.focusRing}", "width": 2, "offset": 2 } }
  }
}
